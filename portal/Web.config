<?xml version="1.0" encoding="utf-8"?>
<!--
  Портал послуг м. Суми та області — конфігурація ASP.NET Web Forms.
  Рядок підключення до MySQL додається на етапі 1.2 (див. ТЗ, розділ 5, 7).
-->
<configuration>
  <!-- Рядок підключення винесено в окремий файл (нативний механізм .NET configSource),
       щоб реальні логін/пароль не потрапляли в git — див. ConnectionStrings.config.example. -->
  <connectionStrings configSource="ConnectionStrings.config" />

  <!-- file="LiqPay.config" домержовує ключі LiqPay (п.1 уточненої постановки) з
       окремого файлу поза git — той самий прийом, що й configSource для
       connectionStrings нижче, тільки appSettings підтримує домердж через file,
       а не повну заміну. LiqPay.config.example — шаблон, комітиться. -->
  <appSettings file="LiqPay.config">
    <add key="SiteTitle" value="Портал послуг Safina" />
    <!-- Без jQuery в проєкті — вимикаємо unobtrusive-валідацію (потребує
         ScriptResourceMapping для jquery), лишаємо класичні inline-скрипти
         ASP.NET для asp:*Validator (працюють без зовнішніх бібліотек). -->
    <add key="ValidationSettings:UnobtrusiveValidationMode" value="None" />
    <!-- Email-сповіщення (п.7 уточненої постановки) — реального SMTP немає
         (той самий dev-режим, що посилання підтвердження/скидання паролю).
         "Pickup" перемикає EmailSender.vb на System.Net.Mail
         SpecifiedPickupDirectory — листи пишуться як .eml у
         App_Data/EmailOutbox/ замість мережі. На бойовому хостингу: прибрати
         цей ключ і додати реальні SMTP-налаштування нижче,
         <system.net><mailSettings><smtp> — код EmailSender.vb не міняється. -->
    <add key="EmailDeliveryMethod" value="Pickup" />
  </appSettings>

  <system.web>
    <compilation debug="true" targetFramework="4.8" />
    <!-- maxRequestLength у КБ: до 5 фото по 3 МБ (ServiceEdit.aspx) + запас. -->
    <httpRuntime targetFramework="4.8" maxRequestLength="20480" executionTimeout="120" />
    <globalization culture="uk-UA" uiCulture="uk-UA"
                   fileEncoding="utf-8" requestEncoding="utf-8" responseEncoding="utf-8" />

    <!-- Портал відкритий для перегляду (рішення 2026-09-11, скасовує закритий
         портал від 01.09): Default/Catalog/ServiceDetails доступні анонімно
         через <location> нижче, все інше (дії — створити оголошення, лишити
         відгук/повідомлення, кабінет) і далі вимагає входу через deny тут. -->
    <authentication mode="Forms">
      <forms loginUrl="~/Login.aspx" timeout="2880" />
    </authentication>
    <authorization>
      <deny users="?" />
    </authorization>

    <customErrors mode="RemoteOnly" />
  </system.web>

  <system.webServer>
    <validation validateIntegratedModeConfiguration="false" />
    <modules runAllManagedModulesForAllRequests="true" />
    <!-- "Default.aspx" НЕ входить у стандартний список default document IIS
         (лише Default.htm/.asp, index.htm/.html, iisstart.htm) — додано для
         повноти конфігурації. УВАГА: сам по собі цей блок НЕ вирішує баг
         редіректу анонімного відвідувача з "/" на Login.aspx (знайдено
         живим тестом 2026-09-11) — IIS резолвить default document на стадії
         ResolveRequestCache, яка виконується ПІСЛЯ ASP.NET-авторизації.
         Реальний фікс — Global.asax.vb: Application_BeginRequest (виконується
         першим у конвеєрі завдяки runAllManagedModulesForAllRequests="true"
         вище) переписує "/" на "~/Default.aspx" ДО авторизації. Не прибирати
         той рерайт, покладаючись лише на цей defaultDocument. -->
    <defaultDocument>
      <files>
        <clear />
        <add value="Default.aspx" />
      </files>
    </defaultDocument>
    <!-- IIS-рівень має свій ліміт розміру запиту (за замовчуванням ~28.6 МБ),
         окремий від httpRuntime/maxRequestLength вище — узгоджуємо явно. -->
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="22000000" />
      </requestFiltering>
    </security>
  </system.webServer>

  <!-- Публічні сторінки, доступні без входу (перевизначають deny users="?" вище). -->
  <location path="Login.aspx">
    <system.web>
      <authorization>
        <allow users="*" />
      </authorization>
    </system.web>
  </location>
  <location path="Register.aspx">
    <system.web>
      <authorization>
        <allow users="*" />
      </authorization>
    </system.web>
  </location>
  <location path="RegisterConsumer.aspx">
    <system.web>
      <authorization>
        <allow users="*" />
      </authorization>
    </system.web>
  </location>
  <location path="RegisterProvider.aspx">
    <system.web>
      <authorization>
        <allow users="*" />
      </authorization>
    </system.web>
  </location>
  <location path="ConfirmEmail.aspx">
    <system.web>
      <authorization>
        <allow users="*" />
      </authorization>
    </system.web>
  </location>
  <location path="ForgotPassword.aspx">
    <system.web>
      <authorization>
        <allow users="*" />
      </authorization>
    </system.web>
  </location>
  <location path="ResetPassword.aspx">
    <system.web>
      <authorization>
        <allow users="*" />
      </authorization>
    </system.web>
  </location>
  <location path="css">
    <system.web>
      <authorization>
        <allow users="*" />
      </authorization>
    </system.web>
  </location>
  <location path="js">
    <system.web>
      <authorization>
        <allow users="*" />
      </authorization>
    </system.web>
  </location>
  <!-- Фото оголошень/галереї (Uploads/Services, Uploads/Gallery) — статичні файли,
       мають бути публічними, як самі сторінки, що на них посилаються (ServiceDetails.aspx,
       Profile.aspx). Без цього правила runAllManagedModulesForAllRequests="true" (фікс
       голого домену, 65905d7) пропускає навіть статичні файли через FormsAuthentication —
       деталі: portal/README.md, грабля про Uploads. -->
  <location path="Uploads">
    <system.web>
      <authorization>
        <allow users="*" />
      </authorization>
    </system.web>
  </location>
  <!-- Донат-модуль (п.1 уточненої постановки) — публічний, без входу. -->
  <location path="Donate.aspx">
    <system.web>
      <authorization>
        <allow users="*" />
      </authorization>
    </system.web>
  </location>
  <location path="DonationCallback.aspx">
    <system.web>
      <authorization>
        <allow users="*" />
      </authorization>
    </system.web>
  </location>
  <location path="DonationResult.aspx">
    <system.web>
      <authorization>
        <allow users="*" />
      </authorization>
    </system.web>
  </location>
  <!-- Політика конфіденційності (п.4 уточненої постановки) — публічна, без входу. -->
  <location path="PrivacyPolicy.aspx">
    <system.web>
      <authorization>
        <allow users="*" />
      </authorization>
    </system.web>
  </location>
  <!-- Відкритий перегляд для USER (п.12, рішення 2026-09-11): головна,
       каталог і картка оголошення доступні без входу. Контактні реквізити
       (телефон) на ServiceDetails.aspx самі ховаються в коді для
       анонімних — Web.config лише відкриває доступ до сторінки. -->
  <location path="Default.aspx">
    <system.web>
      <authorization>
        <allow users="*" />
      </authorization>
    </system.web>
  </location>
  <location path="Catalog.aspx">
    <system.web>
      <authorization>
        <allow users="*" />
      </authorization>
    </system.web>
  </location>
  <location path="ServiceDetails.aspx">
    <system.web>
      <authorization>
        <allow users="*" />
      </authorization>
    </system.web>
  </location>
  <!-- Галерея на акаунті постачальника (постановка робочої тестової версії, 2026-09-12) —
       Profile.aspx?providerId=X публічний перегляд для будь-кого, включно з неавторизованими.
       Без providerId сторінка й далі вимагає входу — сама перевірка в Profile.aspx.vb
       (Response.Redirect на Default.aspx), не тут; <location> лише знімає загальний deny. -->
  <location path="Profile.aspx">
    <system.web>
      <authorization>
        <allow users="*" />
      </authorization>
    </system.web>
  </location>
  <!-- Юридична довідка (постановка робочої тестової версії, 2026-09-12) — публічна, без входу. -->
  <location path="LegalGuide.aspx">
    <system.web>
      <authorization>
        <allow users="*" />
      </authorization>
    </system.web>
  </location>
</configuration>
