<%@ Master Language="VB" AutoEventWireup="true" CodeFile="Site.master.vb" Inherits="SumyPortal.SiteMaster" %>
<!DOCTYPE html>
<html lang="uk">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><asp:ContentPlaceHolder ID="TitleContent" runat="server">Портал послуг Safina</asp:ContentPlaceHolder></title>
    <link rel="stylesheet" href="~/css/site.css" runat="server" />
    <asp:ContentPlaceHolder ID="HeadContent" runat="server" />
</head>
<body>
    <form id="mainForm" runat="server">
        <header class="site-header">
            <a class="site-logo" href="~/Default.aspx" runat="server">Портал послуг</a>
            <nav class="site-nav">
                <a href="~/Default.aspx" runat="server">Головна</a>
                <a href="~/Donate.aspx" runat="server">Підтримати проєкт</a>
                <asp:PlaceHolder ID="anonNav" runat="server">
                    <a href="~/Login.aspx" runat="server">Вхід</a>
                    <a href="~/Register.aspx" runat="server">Реєстрація</a>
                </asp:PlaceHolder>
                <asp:PlaceHolder ID="userNav" runat="server" Visible="false">
                    <a href="~/Catalog.aspx" runat="server">Каталог</a>
                    <asp:HyperLink ID="myServicesLink" runat="server" NavigateUrl="~/MyServices.aspx" Visible="false">Мої оголошення</asp:HyperLink>
                    <a href="~/Favorites.aspx" runat="server">Обране</a>
                    <a href="~/Messages.aspx" runat="server">Повідомлення</a>
                    <a href="~/Profile.aspx" runat="server">Профіль</a>
                    <span class="site-user"><asp:Literal ID="userNameLiteral" runat="server" /></span>
                    <a href="~/Logout.aspx" runat="server">Вихід</a>
                </asp:PlaceHolder>
            </nav>
        </header>

        <main class="site-content">
            <asp:ContentPlaceHolder ID="MainContent" runat="server" />
        </main>

        <footer class="site-footer">
            <p>&copy; <%: DateTime.Now.Year %> Портал послуг Safina · <a href="~/PrivacyPolicy.aspx" runat="server">Політика конфіденційності</a></p>
        </footer>
    </form>
</body>
</html>
