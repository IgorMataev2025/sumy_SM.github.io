<%@ Master Language="VB" AutoEventWireup="true" CodeFile="Site.master.vb" Inherits="SumyPortal.SiteMaster" %>
<!DOCTYPE html>
<html lang="uk">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Базове SEO (п.21, наступна фіча понад MVP, 2026-09-12) — властивість
         MetaDescription (Site.master.vb) дозволяє кожній сторінці задати свій опис;
         за замовчуванням лишається загальний опис порталу. Тег нижче — стандартний
         серверний HtmlMeta-контрол ASP.NET (не голий HTML-тег), саме тому Id й
         властивість Content доступні з code-behind; той самий підхід, що вже title
         через ContentPlaceHolder нижче, тільки тут значення — атрибут, а не текст
         між тегами, тому ContentPlaceHolder не підійшов би. -->
    <meta name="description" runat="server" id="metaDescriptionTag"
        content="Портал послуг Safina — оголошення побутових послуг, медицини, освіти та комунальних послуг у Сумах та області." />
    <title><asp:ContentPlaceHolder ID="TitleContent" runat="server">Портал послуг Safina</asp:ContentPlaceHolder></title>
    <link rel="stylesheet" href="~/css/site.css" runat="server" />
    <asp:ContentPlaceHolder ID="HeadContent" runat="server" />
</head>
<body>
    <form id="mainForm" runat="server">
        <header class="site-header">
            <a class="site-logo" href="~/Default.aspx" runat="server"><asp:Literal runat="server" Text="<%$ Resources:SiteText, SiteLogo %>" /></a>
            <nav class="site-nav">
                <a href="~/Default.aspx" runat="server"><asp:Literal runat="server" Text="<%$ Resources:SiteText, Nav_Home %>" /></a>
                <a href="~/Catalog.aspx" runat="server"><asp:Literal runat="server" Text="<%$ Resources:SiteText, Nav_Catalog %>" /></a>
                <a href="~/LegalGuide.aspx" runat="server"><asp:Literal runat="server" Text="<%$ Resources:SiteText, Nav_LegalGuide %>" /></a>
                <a href="~/Donate.aspx" runat="server"><asp:Literal runat="server" Text="<%$ Resources:SiteText, Nav_Donate %>" /></a>
                <asp:PlaceHolder ID="anonNav" runat="server">
                    <a href="~/Login.aspx" runat="server"><asp:Literal runat="server" Text="<%$ Resources:SiteText, Nav_Login %>" /></a>
                    <a href="~/Register.aspx" runat="server"><asp:Literal runat="server" Text="<%$ Resources:SiteText, Nav_Register %>" /></a>
                </asp:PlaceHolder>
                <asp:PlaceHolder ID="userNav" runat="server" Visible="false">
                    <asp:HyperLink ID="myServicesLink" runat="server" NavigateUrl="~/MyServices.aspx" Visible="false" Text="<%$ Resources:SiteText, Nav_MyServices %>" />
                    <a href="~/Favorites.aspx" runat="server"><asp:Literal runat="server" Text="<%$ Resources:SiteText, Nav_Favorites %>" /></a>
                    <a href="~/Messages.aspx" runat="server"><asp:Literal runat="server" Text="<%$ Resources:SiteText, Nav_Messages %>" /></a>
                    <a href="~/Profile.aspx" runat="server"><asp:Literal runat="server" Text="<%$ Resources:SiteText, Nav_Profile %>" /></a>
                    <span class="site-user"><asp:Literal ID="userNameLiteral" runat="server" /></span>
                    <a href="~/Logout.aspx" runat="server"><asp:Literal runat="server" Text="<%$ Resources:SiteText, Nav_Logout %>" /></a>
                </asp:PlaceHolder>
                <!-- Перемикач мови (постановка робочої тестової версії, 2026-09-12) — лише для
                     публічних сторінок (Default/Catalog/ServiceDetails), решта лишається
                     українською незалежно від cookie (свідоме обмеження обсягу). -->
                <span class="lang-switch">
                    <a href="~/SetLanguage.ashx?lang=uk" runat="server">UA</a> /
                    <a href="~/SetLanguage.ashx?lang=en" runat="server">EN</a>
                </span>
            </nav>
        </header>

        <main class="site-content">
            <asp:ContentPlaceHolder ID="MainContent" runat="server" />
        </main>

        <footer class="site-footer">
            <p>&copy; <%: DateTime.Now.Year %> Портал послуг Safina · <a href="~/PrivacyPolicy.aspx" runat="server"><asp:Literal runat="server" Text="<%$ Resources:SiteText, Footer_PrivacyPolicy %>" /></a></p>
        </footer>
    </form>
</body>
</html>
